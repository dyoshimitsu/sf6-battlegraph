{
  "name": "sf6-battlegraph",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.extension.config.ts && node scripts/package-extension.mjs",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:rules:unit": "vitest run --config vitest.rules.config.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-sf6-battlegraph \"npm run test:rules:unit\""
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "firebase": "^13.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "firebase-tools": "^15.34.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
