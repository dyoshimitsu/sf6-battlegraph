{
  "name": "sf6-battlegraph",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.extension.config.ts && node scripts/package-extension.mjs",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:rules:unit": "vitest run --config vitest.rules.config.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-sf6-battlegraph \"npm run test:rules:unit\""
  },
  "dependencies": {
    "@noble/hashes": "^2.3.0",
    "firebase": "^12.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "firebase-tools": "^15.28.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
