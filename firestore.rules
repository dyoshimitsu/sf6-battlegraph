rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isPublicDeployment() {
      return exists(/databases/$(database)/documents/settings/deployment)
        && get(/databases/$(database)/documents/settings/deployment).data.visibility == 'public';
    }

    function canReadData() {
      return isAdmin() || isPublicDeployment();
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /settings/deployment {
      allow read: if isAdmin() || resource.data.visibility == 'public';
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['visibility'])
        && request.resource.data.visibility in ['private', 'public'];
      allow delete: if false;
    }

    match /players/{userCode} {
      allow read: if canReadData();
      allow write: if isAdmin();

      match /{document=**} {
        allow read: if canReadData();
        allow write: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
