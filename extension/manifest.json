{
  "manifest_version": 3,
  "name": "SF6 Battlegraph Connector",
  "version": "1.1.6",
  "description": "Transfers your Buckler battle log directly to SF6 Battlegraph.",
  "icons": { "128": "icon128.png" },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.streetfighter.com/6/buckler/*"],
      "js": ["auth-watcher.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.streetfighter.com/6/buckler/*/profile/*/battlelog*"],
      "js": ["collector.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.streetfighter.com/6/buckler/*/profile/*/battlelog*"],
      "js": ["buckler-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://localhost/*"],
      "js": ["app-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
